Configs: {
	ModConfig: {
		DisplayName: Mod Config

		Headers: {
			VanillaBossDrops: Vanilla Boss Drops Header
			ModdedBossDrops: Modded Boss Drops Header
			DropCategories: Drop Categories Header
		}

		EnableVanillaBossDrops: {
			Label: Enable Vanilla Boss Master Drops
			Tooltip: If true, vanilla bosses will drop their Master Mode items in non-Master worlds.
		}

		EnableModdedBossDrops: {
			Label: Enable Modded Boss Master Drops
			Tooltip: If true, bosses from supported mods will drop their Master Mode items in non-Master worlds.
		}

		EnableRedemptionDrops: {
			Label: Enable Redemption Drops
			Tooltip: A specific toggle for Redemption mod drops. Requires the master toggle above to be enabled.
		}

		DropPets: {
			Label: Enable Pet Drops
			Tooltip: If true, bosses will drop their master mode exclusive pets in other modes.
		}

		DropMounts: {
			Label: Enable Mount Drops
			Tooltip: If true, bosses will drop their master mode exclusive mounts in other modes.
		}

		DropRelics: {
			Label: Enable Relic Drops
			Tooltip: If true, bosses will drop their master mode exclusive relics in other modes.
		}

		DropLightPets: {
			Label: Enable Light Pet Drops
			Tooltip: If true, bosses will drop their master mode exclusive light pets in other modes.
		}

		DropAccessory: {
			Label: Enable Accessory Drops
			Tooltip: If true, bosses will drop their master mode exclusive accessory in other modes.
		}
	}
}
